---
const RELEASES = "https://github.com/exviolet/sendoff/releases/latest";
const REPO = "https://github.com/exviolet/sendoff";
---

<header class="hero">
  <div class="cells" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>

  <div class="shell inner">
    <p class="mono-label rise" style="animation-delay: 0.05s">
      v0.2.x <span class="sep">/</span> Linux <span class="sep">/</span> MIT
    </p>

    <div class="brand rise" style="animation-delay: 0.12s">
      <img src="/icon.svg" alt="" width="52" height="52" />
      <span class="wordmark">Sendoff</span>
    </div>

    <h1 class="rise" style="animation-delay: 0.2s">
      A real editor for the prompts you send to <em>terminal coding agents</em><span
        class="caret"
        aria-hidden="true"></span>
    </h1>

    <p class="sub rise" style="animation-delay: 0.3s">
      Draft with room to think, bind a tab to Herdr, Orca, or tmux, and send with
      <kbd>Ctrl</kbd>&thinsp;+&thinsp;<kbd>Enter</kbd>.
    </p>

    <div class="actions rise" style="animation-delay: 0.4s">
      <a class="btn primary" href={RELEASES}>
        Download the AppImage
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn ghost" href={REPO}>Source on GitHub</a>
    </div>

    <p class="fineprint rise" style="animation-delay: 0.48s">
      x86_64 &middot; glibc 2.35 or newer &middot; no auto-update
    </p>

    <!-- TODO(демо): сюда встаёт <video> нового дубля (webm + mp4, autoplay muted
         loop playsinline, poster из первого кадра). Слот держит те же пропорции
         1000×562, что и запись, поэтому подстановка не тронет вёрстку.
         Текущий дубль не годится: в кадре виден старый путь `rewrite-desktop`. -->
    <figure class="demo rise" style="animation-delay: 0.56s">
      <div class="demo-frame">
        <div class="chrome" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="demo-slot">
          <p class="mono-label">demo</p>
          <p class="slot-note">
            Drafting a prompt, then <kbd>Ctrl</kbd>&thinsp;+&thinsp;<kbd>Enter</kbd> — it lands in
            the tmux pane as one block, already submitted.
          </p>
        </div>
      </div>
      <figcaption class="mono-label">27 seconds, no narration, no cuts</figcaption>
    </figure>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vh, 7rem) var(--gap-xl);
    overflow: hidden;
    border-bottom: 1px solid var(--line-soft);
  }

  /* Знакоместо. Сетка повторяет ритм моноширинного буфера — 9×22px примерно
     соответствует ячейке Commit Mono на 15px. Это не орнамент: страница про
     редактор, и её пространственная система ссылается на текстовый буфер. */
  .cells {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, #ffffff05 1px, transparent 1px),
      linear-gradient(to bottom, #ffffff04 1px, transparent 1px);
    background-size: 9px 22px;
    mask-image: radial-gradient(120% 80% at 50% 0%, #000 10%, transparent 72%);
  }

  .glow {
    position: absolute;
    top: -28vh;
    left: 50%;
    width: min(1100px, 130vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    background: radial-gradient(circle, #8b5cf62e 0%, #8b5cf600 62%);
    pointer-events: none;
  }

  .inner {
    position: relative;
  }

  .sep {
    color: var(--line);
    padding-inline: 0.35em;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-block: var(--gap-md) var(--gap-sm);
  }

  .wordmark {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  h1 {
    max-width: 20ch;
  }

  /* Италик Newsreader — ради него серифная гарнитура тут и стоит: он выделяет
     «terminal coding agents» не цветом и не жирностью, а сменой голоса. */
  h1 em {
    font-style: italic;
    font-variation-settings: "opsz" 72;
    color: var(--violet);
  }

  /* Курсор в конце заголовка: страница про редактор, и заголовок читается как
     строка, которую только что набрали. Один жест, не аттракцион. */
  .caret {
    display: inline-block;
    width: 0.055em;
    height: 0.78em;
    margin-left: 0.12em;
    vertical-align: baseline;
    background: var(--ember);
    animation: blink 1.15s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .sub {
    margin-top: var(--gap-md);
    max-width: 56ch;
    color: var(--ink-dim);
    font-size: 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--gap-md);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.72em 1.3em;
    border-radius: var(--radius);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border: 1px solid transparent;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .primary {
    background: var(--ink);
    color: var(--ground-deep);
  }

  .primary:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  .primary .arrow {
    transition: transform 0.2s var(--ease);
  }

  .primary:hover .arrow {
    transform: translateX(3px);
  }

  .ghost {
    border-color: var(--line);
    color: var(--ink-dim);
  }

  .ghost:hover {
    border-color: var(--violet-deep);
    color: var(--ink);
  }

  .fineprint {
    margin-top: var(--gap-sm);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  /* --- Слот демо --- */

  .demo {
    margin-top: var(--gap-lg);
  }

  .demo-frame {
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-solid);
    overflow: hidden;
    box-shadow:
      0 1px 0 #ffffff0a inset,
      0 30px 80px -30px #000;
  }

  .chrome {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line-soft);
  }

  .chrome span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .demo-slot {
    aspect-ratio: 1000 / 562;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-sm);
    padding: var(--gap-md);
    text-align: center;
    /* Штриховка «здесь будет запись» — заглушка обязана читаться как заглушка,
       иначе её забудут заменить. */
    background-image: repeating-linear-gradient(
      -45deg,
      #ffffff05 0 1px,
      transparent 1px 11px
    );
  }

  .slot-note {
    max-width: 46ch;
    color: var(--ink-faint);
    font-size: 0.84rem;
  }

  figcaption {
    margin-top: 0.9rem;
    text-align: right;
  }

  @media (max-width: 640px) {
    .actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
