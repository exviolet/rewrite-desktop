---
// Формулировки сверены с README и с секцией Safety Rails в CLAUDE.md. Здесь легче
// всего соврать в сторону «безопаснее, чем есть» — поэтому сказано и то, что
// доступ к домашнему каталогу выдан.
const facts = [
  {
    k: "No network",
    v: "The editor makes no network calls. No backend, no API keys, no telemetry, no accounts.",
  },
  {
    k: "No arbitrary processes",
    v: "The webview gets tmux plus orca-ide and herdr, allowlisted per subcommand — not wholesale.",
  },
  {
    k: "One narrow write",
    v: "Saving a pasted image takes bytes and nothing else: the directory is the app's own, the name is generated, the format comes from the file signature.",
  },
];
---

<section id="boundary">
  <div class="shell">
    <div class="section-head">
      <span class="num">03</span>
      <h2>Where the editor stops</h2>
    </div>

    <p class="lede">
      An editor with read and write access to your home directory is only reasonable if it cannot
      phone anywhere. That is the whole boundary, and it is written down rather than implied.
    </p>

    <dl class="facts">
      {
        facts.map((f) => (
          <div class="fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>

    <p class="aside">
      Home-directory file access <em>is</em> granted — that is the trade, stated plainly. The full
      permission manifest is one file:
      <a
        href="https://github.com/exviolet/sendoff/blob/master/src-tauri/capabilities/default.json"
        >src-tauri/capabilities/default.json</a
      >.
    </p>
  </div>
</section>

<style>
  .facts {
    margin-top: var(--gap-lg);
    display: grid;
    gap: 0;
  }

  .fact {
    display: grid;
    grid-template-columns: minmax(200px, 15rem) 1fr;
    gap: var(--gap-sm);
    padding-block: 1.4rem;
    border-top: 1px solid var(--line-soft);
    align-items: start;
  }

  .fact:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  dt {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--violet);
  }

  dd {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-dim);
    max-width: var(--measure);
  }

  .aside {
    margin-top: var(--gap-md);
    max-width: var(--measure);
    font-size: 0.84rem;
    color: var(--ink-faint);
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }

  .aside em {
    font-family: "Newsreader Variable", Georgia, serif;
    font-style: italic;
    font-size: 1.1em;
    color: var(--ink-dim);
  }

  .aside a {
    color: var(--violet);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #8b5cf655;
  }

  .aside a:hover {
    text-decoration-color: var(--violet);
  }

  @media (max-width: 700px) {
    .fact {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
