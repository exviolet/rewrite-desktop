---
// Три шага, а не список фич. Петля — единственное, что читателю обязательно
// понять до скачивания: где он пишет, куда это улетает и как возвращается ответ.
const steps = [
  {
    n: "01",
    title: "Draft",
    body: "A real editing surface — markdown that continues its own lists, reusable phrases, find and replace. Tabs survive restarts and group by project.",
  },
  {
    n: "02",
    title: "Send",
    body: "The tab is bound to one target: a Herdr agent, an Orca agent, or a plain tmux pane. Multi-line prompts arrive as a single block, already submitted.",
    chord: true,
  },
  {
    n: "03",
    title: "Keep in view",
    body: "Paste the reply into the reference panel and it stays pinned beside the editor while you write the follow-up.",
  },
];
---

<section id="loop">
  <div class="shell">
    <div class="section-head">
      <span class="num">01</span>
      <h2>The loop</h2>
    </div>

    <p class="lede">
      Sendoff exists for one movement, repeated all day: think in an editor, land in a terminal,
      come back with the answer still on screen.
    </p>

    <ol class="steps">
      {
        steps.map((s) => (
          <li class:list={["step", { accent: s.chord }]}>
            <span class="mono-label n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            {s.chord && (
              <p class="chord">
                <kbd>Ctrl</kbd>&thinsp;+&thinsp;<kbd>Enter</kbd>
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <p class="aside">
      When a binding is ambiguous, Sendoff asks instead of guessing — a prompt in the wrong agent
      is worse than an extra click.
    </p>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin-top: var(--gap-lg);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    /* Швы между шагами — фон, просвечивающий сквозь grid gap. Одна линия вместо
       трёх рамок: блоки читаются как одна лента, а не как три карточки. */
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .step {
    position: relative;
    padding: var(--gap-md) 1.6rem var(--gap-md) 1.6rem;
    background: var(--ground);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background-color 0.25s var(--ease);
  }

  .step:hover {
    background: var(--panel-solid);
  }

  .step .n {
    color: var(--ink-faint);
  }

  .step p {
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  /* Средний шаг — единственный тёплый. Это и есть то, ради чего продукт есть. */
  .accent::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--ember), transparent);
  }

  .chord {
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .aside {
    margin-top: var(--gap-md);
    max-width: var(--measure);
    font-size: 0.84rem;
    color: var(--ink-faint);
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }
</style>
