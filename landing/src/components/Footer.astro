---
const links = [
  { label: "Product repo", href: "https://github.com/exviolet/sendoff" },
  { label: "Editor (sendoff-web)", href: "https://github.com/exviolet/sendoff-web" },
  { label: "Releases", href: "https://github.com/exviolet/sendoff/releases" },
  { label: "MIT licence", href: "https://github.com/exviolet/sendoff/blob/master/LICENSE" },
];
---

<footer>
  <div class="shell inner">
    <div class="mark">
      <img src="/icon.svg" alt="" width="34" height="34" />
      <div>
        <p class="name">Sendoff</p>
        <p class="mono-label">Prompt-first editor</p>
      </div>
    </div>

    <nav aria-label="Project links">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="shell note">
    <p>
      Formerly <em>Rewrite</em>. Renamed in August 2026 — the old name read as “AI paraphraser”,
      which is the one thing this editor deliberately is not.
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line-soft);
    padding-block: var(--gap-lg) var(--gap-md);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-md);
    justify-content: space-between;
    align-items: flex-start;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .name {
    font-weight: 700;
    font-size: 0.95rem;
  }

  nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  nav a {
    font-size: 0.84rem;
    color: var(--ink-dim);
    transition: color 0.2s var(--ease);
  }

  nav a:hover {
    color: var(--violet);
  }

  .note {
    margin-top: var(--gap-lg);
    padding-top: var(--gap-sm);
    border-top: 1px solid var(--line-soft);
  }

  .note p {
    font-size: 0.78rem;
    color: var(--ink-faint);
    max-width: var(--measure);
  }

  .note em {
    font-family: "Newsreader Variable", Georgia, serif;
    font-style: italic;
    font-size: 1.12em;
  }
</style>
