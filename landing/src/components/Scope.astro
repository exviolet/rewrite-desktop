---
// Блок «чего тут нет» стоит на странице открыто и намеренно. На Show HN завышенное
// обещание наказывается сильнее узкого скоупа, а README этот тон уже держит —
// расходиться лендингу с ним нельзя.
const limits = [
  "Linux only, x86_64 only. No Windows or macOS builds.",
  "No auto-update. New version means a new download.",
  "No data migrations — breaking changes land as clean sweeps.",
  "Tests cover pure logic and the storage layer. Components are not covered, on purpose.",
  "Issues may sit. Contributions are not being solicited — fork freely instead.",
];
---

<section id="scope">
  <div class="shell">
    <div class="section-head">
      <span class="num">04</span>
      <h2>Honest scope</h2>
    </div>

    <p class="lede">
      A personal tool, used daily, made public so it can be useful and serve as a portfolio piece.
      It works — but nobody should lose an evening finding out what it is not.
    </p>

    <ul class="limits">
      {
        limits.map((l) => (
          <li>
            <span class="mark" aria-hidden="true">
              —
            </span>
            {l}
          </li>
        ))
      }
    </ul>

    <p class="warn">
      <strong>One trap worth naming.</strong> Don't run the AppImage and a source build on the same
      machine. They share a data directory, and a newer WebKit silently upgrades the database format
      the first time it opens it — after which the AppImage can no longer read it. Nothing is lost:
      when Sendoff cannot read, it stops writing altogether.
    </p>
  </div>
</section>

<style>
  .limits {
    list-style: none;
    padding: 0;
    margin-top: var(--gap-lg);
    display: grid;
    gap: 0.7rem;
    max-width: var(--measure);
  }

  .limits li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    font-size: 0.88rem;
    color: var(--ink-dim);
  }

  .mark {
    color: var(--ink-faint);
  }

  /* Единственная рамка на странице, где акцент не фиолетовый и не тёплый:
     предупреждение обязано отличаться от всего остального, иначе его пролистают. */
  .warn {
    margin-top: var(--gap-md);
    max-width: var(--measure);
    padding: 1.1rem 1.3rem;
    font-size: 0.84rem;
    color: var(--ink-dim);
    background: #e8a33d0a;
    border: 1px solid #e8a33d33;
    border-radius: var(--radius);
  }

  .warn strong {
    color: var(--ember);
    font-weight: 700;
  }
</style>
