---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import CoreLoop from "../components/CoreLoop.astro";
import Gallery from "../components/Gallery.astro";
import Boundary from "../components/Boundary.astro";
import Scope from "../components/Scope.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Sendoff — a real editor for the prompts you send to terminal coding agents"
  description="Draft with room to think, bind a tab to Herdr, Orca, or tmux, and send with Ctrl+Enter. Linux, local, keyboard-driven, MIT."
>
  <Hero />
  <main>
    <CoreLoop />
    <Gallery />
    <Boundary />
    <Scope />
  </main>
  <Footer />
</Base>
